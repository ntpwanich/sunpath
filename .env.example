# คัดลอกเป็น .env แล้วแก้ตามเครื่องตัวเอง — .env ไม่ถูก commit
# ค่าตั้งต้นนี้ตรงกับ docker-compose.yml (pnpm db:up)
DATABASE_URL="postgresql://sunpath:sunpath@localhost:5433/sunpath?schema=public"

# ฐานข้อมูลของ integration test — คนละ database กับตอนพัฒนา เพราะทุก test ทำ TRUNCATE
TEST_DATABASE_URL="postgresql://sunpath:sunpath@localhost:5433/sunpath_test?schema=public"

# อีเมลสรุปงานค้างประจำวัน — ค่าตั้งต้นเขียนลง log ระบบจึงเดินได้ครบโดยไม่มี provider
EMAIL_SENDER="log"
# EMAIL_SENDER="mailjet"
# MAILJET_API_KEY=""
# MAILJET_API_SECRET=""
# MAILJET_FROM_ADDRESS=""

# กัน Route Handler ของ cron ถูกยิงจากภายนอก (ADR 0002)
CRON_SECRET=""
