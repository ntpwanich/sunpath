model Contact {
  id          String   @id @default(uuid(7)) @db.Uuid
  contactName String
  phoneNumber String   @unique // เบอร์เดียวกัน = คนเดียวกัน
  createdAt   DateTime

  opportunities Opportunity[]
  customer      Customer?
}

// เกิดตอนปิดการขายได้ครั้งแรกเท่านั้น คนที่ยังไม่เคยซื้อจะมีแต่แถวใน Contact
model Customer {
  id         String   @id @default(uuid(7)) @db.Uuid
  contactId  String   @unique @db.Uuid
  firstWonAt DateTime

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}
