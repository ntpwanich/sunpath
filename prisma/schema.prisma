// SunPath — Prisma schema
//
// ADR 0001: ห้ามใช้ @default(now()) กับฟิลด์ใดที่ business logic อ่าน
// (createdAt, contactedAt, stageChangedAt, วันที่ออก Quotation Revision)
// ฟิลด์เหล่านั้นต้องถูกเขียนจากชั้น application เสมอ โดยรับ now: Date เข้ามา
// ใช้ค่าตั้งต้นจากฐานข้อมูลได้เฉพาะฟิลด์ที่ไม่มีใครตัดสินใจจากมัน
//
// model ทั้งแปดตาม spec §6 จะถูกเพิ่มในงานก้อนถัดไป (branch `schema`)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
